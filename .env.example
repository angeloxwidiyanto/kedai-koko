# Supabase Postgres — pakai connection string "Transaction pooler" (port 6543)
# Contoh: Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase Storage (untuk upload foto produk) — dari Project Settings → API
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Secret untuk menandatangani token login (WAJIB di produksi).
# Generate acak panjang, mis. `openssl rand -hex 32`
AUTH_SECRET=dev-secret-ganti-di-produksi

# PIN awal akun admin (default 1234). Setelah login, ganti lewat menu Admin → Pengguna.
# ADMIN_PIN=1234

# Opsional — batasi origin yang boleh memanggil API (default: *)
# CORS_ORIGIN=https://kedai-koko.vercel.app
